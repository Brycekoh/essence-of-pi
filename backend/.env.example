# Every value here has a working default -- this file documents the knobs,
# it isn't required to run the app.

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Reject uploads larger than this many bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# Where uploaded PDFs are written. Relative paths resolve against backend/.
# UPLOAD_DIR=storage/uploads

# Added in milestone 2, when the LLM enters the picture:
# GEMINI_API_KEY=
