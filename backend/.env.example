# Copy to backend/.env and set GEMINI_API_KEY.
#
# Only GEMINI_API_KEY is live. Everything else is commented out on purpose: the
# defaults live in app/config.py, and an uncommented line here would override
# them -- then quietly go stale when a default changes. This file once pinned
# RENDERER_IMAGE to an image with no ffmpeg, which would have broken every
# narrated video for anyone who copied it. Uncomment a line only to change it.
#
# docker compose reads this file too. Its own DATABASE_URL, ALLOWED_ORIGINS and
# storage paths take precedence over anything set here.

# --- Required ------------------------------------------------------------------
# A free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Language model ------------------------------------------------------------
# Pinned, not a -latest alias, so a measured success rate means something.
# LLM_MODEL=gemini-3.8-flash
# Tried in order when a model is busy or out of its 20-requests-per-day quota.
# LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# MAX_CONCEPTS=6
# Characters of the paper sent for extraction. 60000 drew repeated 503s.
# MAX_CHARS_TO_MODEL=30000

# --- Video generation ----------------------------------------------------------
# Scenes per concept. The main lever on how fast the free-tier quota goes.
# MAX_SCENES=3
# MAX_RENDER_ATTEMPTS=3
# FALLBACK_TO_TITLE_CARD=true
# Scenes rendering at once, across every job.
# MAX_PARALLEL_RENDERS=2

# --- Rendering sandbox ---------------------------------------------------------
# Must carry ffmpeg. The upstream manimcommunity/manim image does not.
# RENDERER_IMAGE=essence-of-pi/render:latest
# -ql 480p (fast)   -qm 720p   -qh 1080p (slow)
# RENDER_QUALITY=-qm
# RENDER_MEMORY=2g
# RENDER_CPUS=2
# RENDER_TIMEOUT_SECONDS=300
# MEDIA_TIMEOUT_SECONDS=180
# RENDERER_DOCKER_BIN=docker

# --- Narration -----------------------------------------------------------------
# kokoro (default, most natural) | piper (lighter) | gtts (no image, needs network)
# SPEECH_ENGINE=kokoro
# KOKORO_IMAGE=essence-of-pi/tts:kokoro
# Voices baked into the image: af_bella af_heart af_nicole am_michael am_adam bf_emma
# KOKORO_VOICE=af_bella
# Below 1.0 is slower.
# KOKORO_SPEED=0.92
# Seconds of pause between sentences, for Kokoro and Piper.
# SPEECH_SENTENCE_SILENCE=0.35
# Piper only. Above 1.0 is slower. Leave the noise settings unset to use the
# voice's own defaults.
# PIPER_VOICE=/opt/voices/en_US-hfc_female-medium.onnx
# SPEECH_LENGTH_SCALE=1.12
# SPEECH_NOISE_SCALE=0.25
# SPEECH_NOISE_W_SCALE=0.25
# gTTS only. SPEECH_TLD changes the accent: com, co.uk, com.au.
# SPEECH_LANG=en
# SPEECH_TLD=com

# --- Storage and server --------------------------------------------------------
# Unset means an in-memory store that forgets everything on restart.
# docker compose sets this for you.
# DATABASE_URL=postgresql+psycopg://eop:eop@localhost:5432/essence_of_pi
# Host development only -- under compose these must stay inside the volume.
# UPLOAD_DIR=storage/uploads
# VIDEOS_DIR=storage/videos
# MAX_UPLOAD_BYTES=26214400
# ALLOWED_ORIGINS=http://localhost:3000
# Finished jobs kept for status polling. Running jobs are never evicted.
# JOB_HISTORY=50
