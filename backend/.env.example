# Copy to backend/.env and fill in what you need.
# Everything except GEMINI_API_KEY has a working default.

# --- LLM (milestone 2) ---
# Required for the concept endpoints. Free key: https://aistudio.google.com/apikey
# Without it the app still boots and serves papers; /concepts returns 503.
GEMINI_API_KEY=

# gemini-2.0-flash is the cheap default. gemini-2.5-flash is stronger and
# slower; anything the google-genai SDK accepts works here.
LLM_MODEL=gemini-2.0-flash

# How many concepts to ask for per paper.
MAX_CONCEPTS=6

# How much of the paper to send to the model, in characters (~15k tokens).
MAX_CHARS_TO_MODEL=60000

# --- Rendering (milestone 3) ---
# Renders run inside this image; nothing is installed on the host.
# Pull it once:  docker pull manimcommunity/manim:stable
RENDERER_IMAGE=manimcommunity/manim:stable
RENDERER_DOCKER_BIN=docker

# -ql 480p15 (~5s), -qm 720p30, -qh 1080p60 (minutes).
RENDER_QUALITY=-qm

# Ceilings on the container. These matter from milestone 4, when the code
# being executed is written by a model.
RENDER_MEMORY=2g
RENDER_CPUS=2
RENDER_TIMEOUT_SECONDS=300

# --- Generated animation (milestone 4) ---
# Attempts at generate -> check -> render -> correct before giving up.
# Each failed attempt costs one model call plus one container start.
MAX_RENDER_ATTEMPTS=3

# When every attempt fails, render the hand-written title card instead, so the
# caller still gets a video. The response reports generated=false.
FALLBACK_TO_TITLE_CARD=true

# --- Server ---
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Reject uploads larger than this many bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# Where uploaded PDFs are written. Relative paths resolve against backend/.
# UPLOAD_DIR=storage/uploads
